{
  "PackageInformation": {
    "SetupType": "EXE",
    "SetupFile": "Greenshot-INSTALLER-1.3.315-RELEASE.exe",
    "Version": "1.3.315"
  },
  "LogPath": "C:\\ProgramData\\Microsoft\\IntuneManagementExtension\\Logs",
  "InstallTasks": {
    "ArgumentList": "/SP- /ALLUSERS /VERYSILENT /SUPPRESSMSGBOXES /CLOSEAPPLICATIONS/NORESTART /LOG=\"#LogPath\\#LogName.log\"",
    "Wait": 60
  },
  "PostInstall": {
    "StopPath": [
      "C:\\Program Files\\Greenshot"
    ],
    "Remove": [
      "C:\\Users\\Public\\Desktop\\Greenshot.lnk",
      "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\Greenshot\\Uninstall Greenshot.lnk",
      "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\Greenshot\\Show license.lnk",
      "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\Greenshot\\Show Readme.lnk"
    ],
    "CopyFile": [
      {
        "Source": "greenshot-defaults.ini",
        "Destination": "C:\\Program Files\\Greenshot\\greenshot-defaults.ini"
      }
    ],
    "Run": []
  }
}
